# Copy this file to .env and fill in real values. .env is gitignored.
# Load it with your process manager (systemd EnvironmentFile, docker --env-file,
# gunicorn --env, or `export $(cat .env | xargs)` for a quick shell test).

# Required when DEBUG=False. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Set to "true" only in local development. Default is False.
DJANGO_DEBUG=false

# Comma-separated host names this app will answer to.
DJANGO_ALLOWED_HOSTS=gxuncodeclub.top,www.gxuncodeclub.top,116.62.68.29

# Comma-separated origins (with scheme) allowed to POST cross-origin to this app.
# Only include https:// in production.
DJANGO_CSRF_TRUSTED_ORIGINS=https://gxuncodeclub.top,https://www.gxuncodeclub.top

# Set to "false" if gunicorn directly serves HTTPS (rare). Default true.
DJANGO_BEHIND_TLS_PROXY=true

# Disable the HTTP→HTTPS redirect (e.g. for an internal health check). Default true.
DJANGO_SECURE_SSL_REDIRECT=true

# HSTS max-age. Default 1 year. Set to 0 to disable while testing.
DJANGO_SECURE_HSTS_SECONDS=31536000
