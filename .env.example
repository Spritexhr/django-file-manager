# Copy this file to .env and fill in real values. .env is gitignored.
# Load it with your process manager (systemd EnvironmentFile, docker --env-file,
# or gunicorn --env). Docker Compose reads the repository .env automatically.

# Required when DEBUG=False. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Set to "true" only in local development. Default is False.
DJANGO_DEBUG=false

# Comma-separated host names this app will answer to.
DJANGO_ALLOWED_HOSTS=gxuncodeclub.top,www.gxuncodeclub.top,116.62.68.29

# Comma-separated origins (with scheme) allowed to POST cross-origin to this app.
# Only include https:// in production.
DJANGO_CSRF_TRUSTED_ORIGINS=https://gxuncodeclub.top,https://www.gxuncodeclub.top

# Set to "false" if gunicorn directly serves HTTPS (rare). Default true.
DJANGO_BEHIND_TLS_PROXY=true

# Disable the HTTP→HTTPS redirect (e.g. for an internal health check). Default true.
DJANGO_SECURE_SSL_REDIRECT=true

# HSTS max-age. Default 1 year. Set to 0 to disable while testing.
DJANGO_SECURE_HSTS_SECONDS=31536000

# Docker host binding for the web service. Production deployments can keep a
# site-specific port in .env without modifying docker-compose.yml.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8002

# --- Media filesystem ------------------------------------------------------
# Optional absolute path (or a path relative to the repository/app directory).
# The Docker default is /app/media, backed by the shared `media` volume.
# DJANGO_MEDIA_ROOT=/data/file-manager/media

# Authenticated downloads stream in 1 MiB chunks by default.
DJANGO_FILE_DOWNLOAD_CHUNK_KB=1024

# Reconcile files written directly through Samba when a user browses their
# directory. Leave false unless the optional Samba profile is intentionally used.
DJANGO_FILESYSTEM_SYNC_ON_BROWSE=false

# --- Optional Samba sidecar ------------------------------------------------
# Used only by: docker compose --profile smb up --build -d
# This is one independent Samba account with access to the entire media volume.
# It is NOT a Django username/password and should be a long, unique secret.
SAMBA_USER=filemanager
SAMBA_PASSWORD=
SAMBA_UID=1000
SAMBA_GID=1000
SAMBA_BIND_ADDRESS=127.0.0.1
SAMBA_PORT=445

# --- Upload limits ---------------------------------------------------------
# Sizes are in MB. Defaults allow large files: 5GB per file, 20GB per batch.
# Raise/lower as needed; these are validated in the app for friendly errors.
DJANGO_MAX_UPLOAD_FILE_MB=5120
DJANGO_MAX_UPLOAD_BATCH_MB=20480
DJANGO_MAX_UPLOAD_FILES=20

# IMPORTANT: the reverse proxy in front of this app (nginx) usually imposes the
# real ceiling. If uploads over ~1GB fail with "413 Request Entity Too Large",
# raise it in the nginx server/location block (0 disables the limit):
#     client_max_body_size 0;
#     proxy_read_timeout 1800s;
#     proxy_request_buffering off;   # stream straight through for big files
